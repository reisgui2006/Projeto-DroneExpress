# Copie este arquivo para ".env" e ajuste. O arquivo .env NÃO deve ir para o Git.

# Conexão com o PostgreSQL (valores criados por banco/criar_banco.sql)
DATABASE_URL=postgresql+psycopg://drone:drone@localhost:5432/droneexpress

# Banco separado usado pelos testes (opcional; sem ele os testes usam SQLite)
TEST_DATABASE_URL=postgresql+psycopg://drone:drone@localhost:5432/droneexpress_test

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000

# Fuso usado para exibir datas no relatório Excel (o banco guarda tudo em UTC)
APP_TIMEZONE=America/Sao_Paulo
